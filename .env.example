# Copy to .env to override the docker compose defaults. Defaults are for the local synthetic demo only.
ORACLE_PORT=25621
POSTGRES_PORT=25632
REPORT_PORT=18090
ORACLE_PASSWORD=sys-dev-only
POSTGRES_PASSWORD=postgres-dev-only
OWNER_PASSWORD=OwnerDev1
READER_PASSWORD=ReaderDev1

# Demo size: orders (customers = rows/20, documents = rows/50) and dual-write simulation length in seconds.
DEMO_ROWS=200000
DEMO_SECONDS=20

# The CLI itself reads connection strings from these variables (preferred over command-line options):
# ORA2PGV_ORACLE=Data Source=localhost:25621/FREEPDB1;User Id=verify_reader;Password=...
# ORA2PGV_POSTGRES=Host=localhost;Port=25632;Database=appdb;Username=verify_reader;Password=...
# ORA2PGV_ORACLE_OWNER / ORA2PGV_POSTGRES_OWNER   only for `seed`, `audit-demo` and `demo`
